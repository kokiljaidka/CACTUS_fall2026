  "ai_overview": {
    "text_blocks": [
      {
        "type": "paragraph",
        "snippet": "Artificial Intelligence (AI) is the simulation of human intelligence processes by computer systems and machines. As defined by the Stanford Human-Centered Artificial Intelligence (HAI) Program, it encompasses any computer system capable of performing tasks that normally require human cognition, such as learning, reasoning, pattern recognition, and decision-making.",
        "snippet_links": [
          {
            "text": "Stanford Human-Centered Artificial Intelligence (HAI) Program",
            "link": "https://hai.stanford.edu/ai-definitions/what-is-artificial-intelligence-ai"
          }
        ],
        "snippet_highlighted_words": [
          "the simulation of human intelligence processes by computer systems and machines"
        ],
        "reference_indexes": [
          0,
          1,
          2
        ]
      },
      {
        "type": "heading",
        "snippet": "Core Technologies"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "Machine Learning (ML): Algorithms that find patterns in data and improve their performance over time without being explicitly programmed."
          },
          {
            "snippet": "Deep Learning: A subset of machine learning using multilayered neural networks modeled after the human brain to process complex data like images, voice, and text."
          },
          {
            "snippet": "Generative AI: Advanced models—such as Large Language Models (LLMs)—that generate new content, code, or media based on prompts.",
            "reference_indexes": [
              1,
              3,
              4,
              5
            ]
          }
        ]
      },
      {
        "type": "heading",
        "snippet": "Types of AI"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "Artificial Narrow Intelligence (ANI): Systems designed to handle a specific, single task (like web search, GPS navigation, or virtual assistants). Most modern AI belongs to this category."
          },
          {
            "snippet": "Artificial General Intelligence (AGI): A theoretical system that matches human cognitive flexibility across any intellectual task."
          },
          {
            "snippet": "Artificial Superintelligence (ASI): A hypothetical future state where AI surpasses human intelligence across all domains.",
            "reference_indexes": [
              5,
              6
            ]
          }
        ]
      },
      {
        "type": "heading",
        "snippet": "Common Applications"
      },
      {
        "type": "list",
        "list": [
          {
            "snippet": "Everyday Tools: Search engines, smartphone personal assistants (like Siri), and predictive text."
          },
          {
            "snippet": "Industry & Science: Medical diagnostics, genomic research, financial modeling, and autonomous transportation."
          },
          {
            "snippet": "Content & Language: Real-time translation, image generation, and automated text summaries.",
            "reference_indexes": [
              0,
              1,
              7,
              8
            ]
          }
        ]
      },
      {
        "type": "paragraph",
        "snippet": "You can learn more about academic foundations and historical context through the Britannica Artificial Intelligence Guide.",
