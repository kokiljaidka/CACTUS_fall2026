y"}, "5": {"Display": "Could teach it to others"}}, "AnswerOrder": ["1", "2", "3", "4", "5"], "DataVisibility": {"Private": false, "Hidden": false}, "Configuration": {"QuestionDescriptionOption": "UseText", "TextPosition": "inline", "MobileFirst": true, "ShowProgress": true, "AutoadvanceStatements": true}, "NextChoiceId": 9, "NextAnswerId": 6, "ChoiceDataExportTags": false}}, {"SurveyID": "SV_0eSs4WkYgoLxBhc", "Element": "SQ", "PrimaryAttribute": "QID8", "SecondaryAttribute": "How often do you use AI assistants (e.g., ChatGPT, Claude, Copilot) to write or debug code?", "TertiaryAttribute": null, "Payload": {"QuestionText": "How often do you use AI assistants (e.g., ChatGPT, Claude, Copilot) to write or debug code?\n", "DataExportTag": "ai_coding", "QuestionID": "QID8", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "QuestionDescription": "How often do you use AI assistants (e.g., ChatGPT, Claude, Copilot) to write or debug code?", "Choices": {"1": {"Display": "Never"}, "2": {"Display": "I've tried it a few times"}, "3": {"Display": "Sometimes"}, "4": {"Display": "Most of the time I write code"}, "5": {"Display": "I don't write code yet"}, "6": {"Display": "I use it to process data but I haven't tried to write code with it myself"}}, "ChoiceOrder": [1, 2, 3, 4, 6, 5], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "DataVisibility": {"Private": false, "Hidden": false}, "Configuration": {"QuestionDescriptionOption": "UseText"}, "NextChoiceId": 7, "NextAnswerId": 1}}, {"SurveyID": "SV_0eSs4WkYgoLxBhc", "Element": "SQ", "PrimaryAttribute": "QID9", "SecondaryAttribute": "How much do you agree with the following statements?", "TertiaryAttribute": null, "Payload": {"QuestionText": "How much do you agree with the following statements?\n", "DataExportTag": "confidence", "QuestionID": "QID9", "QuestionType": "Matrix", "Selector": "Likert", "SubSelector": "SACV", "QuestionDescription": "How much do you agree with the following statements?", "Choices": {"1": {"Display": "I can read a short script and understand roughly what it does."}, "2": {"Display": "I can load a dataset (e.g., a CSV) and compute basic summaries in code."}, "3": {"Display": "When I get an error message, I know how to start fixing it."}, "4": {"Display": "I can tell when AI-generated code is wrong or doing something I didn't intend."}}, "ChoiceOrder": ["1", "2", "3", "4"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": [], "Answers": {"1": {"Display": "Strongly disagree"}, "2": {"Display": "Disagree"}, "3": {"Display": "Neither agree nor disagree"}, "4": {"Display": "Agree"}, "5": {"Display": "Strongly agree"}}, "AnswerOrder": ["1", "2", "3", "4", "5"], "DataVisibility": {"Private": false, "Hidden": false}, "Configuration": {"QuestionDescriptionOption": "UseText", "MobileFirst": true, "ShowProgress": true, "AutoadvanceStatements": true}, "NextChoiceId": 5, "NextAnswerId": 6, "ChoiceDataExportTags": false}}, {"SurveyID": "SV_0eSs4WkYgoLxBhc", "Element": "STAT", "PrimaryAttribute": "Survey Statistics", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"MobileCompatible": true, "ID": "Survey Statistics"}}]}